{
  "version": "0.2",
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "enableGlobDot": true,
  "words": [
    "tailwindcss",
    "clsx",
    "fortytwo",
    "cursus",
    "rncp",
    "dotenv",
    "levelname",
    "lucide",
    "zustand",
    "tanstack",
    "embla",
    "partialize",
    "applicatif",
    "Coolify",
    "données",
    "fieldsets",
    "nums",
    "piscines",
    "retriable",
    "Traefik",
    "gomoku",
    "navigations",
    "optimise",
    "projet",
    "projets",
  ],
  "useGitignore": true,
  "ignorePaths": [
    "cspell.json",
    ".git/**",
    ".gitignore",
    ".github/workflows/*",
    "package.json",
    "package-lock.json",
    "scripts/**",
    "/src/components/ui/**",
    "data/*",
    "optimizer/data/*",
    "optimizer/*.py",
    "src/data/planner.json",
    "scratch_projects.txt",
    "public/*",
    ".dockerignore",
    "Dockerfile",
    "compose.yaml",
  ]
}
